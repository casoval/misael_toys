# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo ".env" NUNCA se sube a git (ver .gitignore).
#
# Sin este archivo, el proyecto NO ARRANCA (Django exige SECRET_KEY).

# --- Seguridad de Django ---
# Genera una clave nueva y única para producción, por ejemplo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pon-aqui-una-clave-larga-y-secreta

# En tu máquina local: True. En el servidor de producción: False (¡importante!
# con True en el servidor público, cualquier error muestra información
# sensible del código a cualquiera que lo vea).
DEBUG=True

# Dominios permitidos, separados por coma. En producción:
# ALLOWED_HOSTS=tienda.neuromisael.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# DB_ENGINE=sqlite (por defecto, no necesita nada más) o DB_ENGINE=postgres
DB_ENGINE=sqlite

# Solo si DB_ENGINE=postgres, completa estos:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
