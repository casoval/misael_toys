         {% if user.is_staff %}<a style="--c:#FF6F59" href="{% url 'panel:cotizacion_medida' %}" {% if u == 'cotizacion_medida' %}class="on"{% endif %}>A medida</a>{% endif %}
         <a style="--c:#F0609B" href="{% url 'panel:cotizaciones' %}" {% if u == 'cotizaciones' or u == 'cotizacion_detalle' %}class="on"{% endif %}>Cotizaciones</a>
         {% if user.is_staff %}<a style="--c:#FFB238;--t:#3a2a00" href="{% url 'panel:usuarios' %}" {% if u == 'usuarios' %}class="on"{% endif %}>Usuarios</a>{% endif %}
diff --git a/templates/panel/lote_detalle.html b/templates/panel/lote_detalle.html
new file mode 100644
