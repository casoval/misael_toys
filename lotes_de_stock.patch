+++ b/templates/panel/lote_detalle.html
@@ -0,0 +1,38 @@
+{% extends "panel/base_panel.html" %}
+{% block titulo %}Entrada #{{ lote.pk }}{% endblock %}
+{% block contenido %}
+<p><a href="{% url 'panel:lotes' %}">← Todos los lotes</a></p>
+<div class="p-titulo"><h1>Entrada #{{ lote.pk }} <span class="p-tag {% if lote.modo == 'fijar' %}warn{% endif %}">{{ lote.get_modo_display|upper }}</span></h1>
+  <a class="p-btn" href="{% url 'panel:lote_pdf' lote.pk %}" target="_blank" rel="noopener">🖨 Imprimir PDF</a></div>
+<p class="p-soft">{{ lote.creado|date:"d/m/Y H:i" }} · hecho por <b>{{ lote.usuario.username|default:"—" }}</b>{% if lote.nota %} · Nota: {{ lote.nota }}{% endif %}</p>
+
+<div class="p-kpis">
+  <div><span class="p-soft">Productos</span><b>{{ n_productos }}</b></div>
+  <div><span class="p-soft">Cantidades guardadas</span><b>{{ lote.aplicados }}</b></div>
+  <div><span class="p-soft">{% if lote.modo == 'fijar' %}Diferencia neta{% else %}Unidades sumadas{% endif %}</span><b>{{ unidades|stringformat:"+d" }}</b></div>
+</div>
+{% if lote.sin_cambio %}<p class="p-soft">{{ lote.sin_cambio }} cantidad{{ lote.sin_cambio|pluralize:",es" }} ya {{ lote.sin_cambio|pluralize:"era,eran" }} igual{{ lote.sin_cambio|pluralize:",es" }} a lo registrado, por eso no generaron movimiento.</p>{% endif %}
+
+{% if por_ubicacion|length > 1 %}
+<div class="p-card"><h2>Por ubicación</h2>
+  {% for r in por_ubicacion %}<div class="p-linea"><b>{{ r.nombre }}</b><span>{{ r.productos }} producto{{ r.productos|pluralize }}</span><span>{{ r.unidades|stringformat:"+d" }} unid.</span></div>{% endfor %}
+</div>
+{% endif %}
+
+<div class="p-tabla-wrap">
+<table class="p-tabla p-tabla-lote">
+  <thead><tr><th>Producto</th><th>Ubicación</th>{% if con_saldos %}<th class="t-num">Había</th>{% endif %}<th class="t-num">{% if con_saldos %}Cambio{% else %}Cantidad{% endif %}</th>{% if con_saldos %}<th class="t-num">Quedó</th>{% endif %}</tr></thead>
+  <tbody>
+  {% for m in movs %}
+    <tr>
+      <td>{% if m.producto.codigo %}<span class="p-prod-cod">{{ m.producto.codigo }}</span> {% endif %}<a href="{% url 'panel:stock_producto' m.producto_id %}"><b>{{ m.producto.nombre }}</b></a></td>
+      <td>{{ m.ubicacion.nombre }}</td>
+      {% if con_saldos %}<td class="t-num">{{ m.antes|default_if_none:"—" }}</td>{% endif %}
+      <td class="t-num {% if m.cantidad > 0 %}pos{% else %}neg{% endif %}"><b>{{ m.cantidad|stringformat:"+d" }}</b></td>
+      {% if con_saldos %}<td class="t-num"><b>{{ m.despues|default_if_none:"—" }}</b></td>{% endif %}
+    </tr>
+  {% empty %}<tr><td colspan="{% if con_saldos %}5{% else %}3{% endif %}" class="p-soft">Este lote no generó ningún movimiento (todo ya estaba con esas cantidades).</td></tr>{% endfor %}
+  </tbody>
+</table>
+</div>
+{% endblock %}
diff --git a/templates/panel/lotes_lista.html b/templates/panel/lotes_lista.html
new file mode 100644
index 0000000..1ec1ba7
--- /dev/null
+++ b/templates/panel/lotes_lista.html
@@ -0,0 +1,37 @@
+{% extends "panel/base_panel.html" %}
+{% block titulo %}Entradas de stock{% endblock %}
+{% block contenido %}
+<h1>Entradas de stock (lotes)</h1>
+<p class="p-soft">Cada carga en lote y cada ingreso suelto queda aquí, y se puede imprimir en PDF. Cada vez que guardas una <a href="{% url 'panel:stock_carga' %}">carga en lote</a> queda aquí. Abre uno para ver, producto por producto, lo que había y lo que quedó.
+  · <a href="{% url 'panel:movimientos' %}">Ver todos los movimientos (ingresos sueltos, ventas, traslados, ajustes)</a></p>
+
+<form class="p-filtros" method="get">
+  <input type="search" name="q" value="{{ f.q }}" placeholder="Buscar por N° de lote, producto, código, nota o usuario…" autocomplete="off">
+  <select name="modo" aria-label="Modo">
+    <option value="">Sumar y fijar</option>
+    {% for clave, etiqueta in modos %}<option value="{{ clave }}" {% if f.modo == clave %}selected{% endif %}>{{ etiqueta }}</option>{% endfor %}
+  </select>
+  <select name="usuario" aria-label="Usuario"><option value="">Todos los usuarios</option>
+    {% for u in usuarios %}<option value="{{ u.pk }}" {% if f.usuario == u.pk|stringformat:"s" %}selected{% endif %}>{{ u.username }}</option>{% endfor %}
+  </select>
+  <label>Desde <input type="date" name="desde" value="{{ f.desde }}"></label>
+  <label>Hasta <input type="date" name="hasta" value="{{ f.hasta }}"></label>
+  <button class="p-btn p-btn-sec" type="submit">Filtrar</button>
+  {% if f.q or f.modo or f.usuario or f.desde or f.hasta %}<a class="p-btn p-btn-sec" href="{% url 'panel:lotes' %}">Limpiar</a>{% endif %}
+</form>
+
+<div class="p-lista">
+{% for l in lotes %}
+  <div class="p-fila-lote">
+  <a class="p-fila-venta" href="{% url 'panel:lote_detalle' l.pk %}">
+    <div><strong>Entrada #{{ l.pk }}</strong> <span class="p-soft">{{ l.creado|date:"d/m/Y H:i" }}</span>
+      <span class="p-tag {% if l.modo == 'fijar' %}warn{% endif %}">{{ l.get_modo_display|upper }}</span><br>
+      <span class="p-soft">{{ l.usuario.username|default:"—" }} · {{ l.n_productos }} producto{{ l.n_productos|pluralize }} · {{ l.aplicados }} cantidad{{ l.aplicados|pluralize:",es" }}{% if l.sin_cambio %} (+{{ l.sin_cambio }} sin cambio){% endif %}</span>
+      {% if l.nota %}<br><span class="p-codigos">{{ l.nota }}</span>{% endif %}</div>
+    <div class="p-monto {% if l.neto and l.neto < 0 %}neg{% endif %}">{{ l.neto|default:0|stringformat:"+d" }} unid.</div>
+  </a>
+  <a class="p-btn p-btn-sec p-pdf" href="{% url 'panel:lote_pdf' l.pk %}" target="_blank" rel="noopener" title="Imprimir esta entrada en PDF">🖨 PDF</a>
+  </div>
+{% empty %}<p class="p-soft">{% if f.q or f.modo or f.usuario or f.desde or f.hasta %}No hay lotes con esos filtros. <a href="{% url 'panel:lotes' %}">Quitar los filtros</a>{% else %}Aún no hiciste ninguna carga en lote.{% endif %}</p>{% endfor %}
+</div>
+{% endblock %}
diff --git a/templates/panel/movimientos_lista.html b/templates/panel/movimientos_lista.html
new file mode 100644
index 0000000..679c1cd
--- /dev/null
